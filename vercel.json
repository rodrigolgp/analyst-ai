{
  "functions": {
    "api/*.js": { "maxDuration": 30 },
    "api/precalc.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "crons": [
    { "path": "/api/precalc", "schedule": "45 12 * * 1-5" },
    { "path": "/api/precalc", "schedule": "0 15 * * 1-5" },
    { "path": "/api/monitor", "schedule": "0 13 * * 1-5" }
  ]
}
